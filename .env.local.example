NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google OAuth: configure in Supabase Dashboard → Authentication → Providers → Google
# 1. Create OAuth credentials at https://console.cloud.google.com/apis/credentials
# 2. Set Authorized redirect URI to: https://your-project.supabase.co/auth/v1/callback
# 3. Add Client ID and Secret in Supabase Dashboard
